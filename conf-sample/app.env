# Standup bot configuration.
#
# Copy this folder to conf/ and fill in the values. The app reads conf/app.env from the
# folder it is started in. A variable set in the real environment overrides the same
# name here.

# --- Slack -------------------------------------------------------------------------
# api.slack.com/apps → your app → OAuth & Permissions → Bot User OAuth Token
SLACK_BOT_TOKEN=xoxb-...
# api.slack.com/apps → your app → Basic Information → Signing Secret
SLACK_SIGNING_SECRET=...
# Channel ID the finished reports are posted to. Leave empty to not post them.
# The bot must be a member of the channel.
SLACK_UPDATES_CHANNEL=C0123456789

# --- Redmine -----------------------------------------------------------------------
# Base URL of your Redmine, without a trailing slash. Its REST API must be enabled.
# Each person's own API key is stored in the database by /link-redmine, not here.
REDMINE_BASE_URL=https://redmine.example.com

# --- App ---------------------------------------------------------------------------
PORT=3000
# The public HTTPS address of this app. Slack's dashboard links are built from it.
PUBLIC_URL=https://standup.example.com
# SQLite database file. Created on first start.
DB_PATH=./data/app.db
# When to remind people who have not submitted, as a cron expression in TZ.
# Leave empty for no reminder. This one is 10:00 on weekdays.
SUBMISSION_REMINDER_CRON=0 10 * * 1-5
# The team's time zone (IANA name). It decides what "today" means everywhere.
TZ=Asia/Ho_Chi_Minh
