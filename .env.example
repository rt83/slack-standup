# Slack
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...
SLACK_UPDATES_CHANNEL=C0123456789 # channel to post finished reports into; leave empty to not post

# Redmine
# Each person's own Redmine API key is stored in the database (see /link-redmine), not here.
REDMINE_BASE_URL=https://redmine.example.com

# App
PORT=3000
PUBLIC_URL=https://standup.yourcompany.com   # publicly reachable base URL — used to build dashboard links in Slack
DB_PATH=./data/app.db
SUBMISSION_REMINDER_CRON=0 10 * * 1-5   # 10:00 on weekdays, in TZ below; leave empty for no reminder
TZ=America/New_York                     # the team's time zone: decides what "today" means everywhere
