# Slack
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...
SLACK_APP_TOKEN=xapp-...          # only needed if using Socket Mode
SLACK_UPDATES_CHANNEL=C0123456789 # channel to post finished reports into

# Redmine
REDMINE_BASE_URL=https://redmine.example.com
# Each user's personal Redmine API key is stored in the DB (users table),
# not here. This is only a fallback/admin key for lookups that don't need
# per-user auth (e.g. loading global status lists).
REDMINE_ADMIN_API_KEY=

# App
PORT=3000
PUBLIC_URL=https://standup.yourcompany.com   # publicly reachable base URL — used to build dashboard links in Slack
DB_PATH=./data/app.db
SUBMISSION_REMINDER_CRON=0 10 * * 1-5   # 10:00 on weekdays, in TZ below
TZ=America/New_York
